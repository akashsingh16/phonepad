<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Starting..."
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnModeSwitch"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="4dp"
        android:background="@color/btn"
        android:text="Switch to WiFi"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/statusText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnLayoutToggle"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:background="@color/btn"
        android:text="⌨ Keyboard"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:paddingHorizontal="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnGuide"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@color/btn"
        android:text="◎"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/btnModeSwitch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/rowBackStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/btnGuide"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="64dp"
            android:layout_height="40dp"
            android:layout_marginEnd="16dp"
            android:background="@color/btn"
            android:text="Back"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="64dp"
            android:layout_height="40dp"
            android:background="@color/btn"
            android:text="Start"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnLB"
        android:layout_width="72dp"
        android:layout_height="40dp"
        android:layout_margin="10dp"
        android:background="@color/btn"
        android:text="LB"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnLT"
        android:layout_width="72dp"
        android:layout_height="40dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="6dp"
        android:background="@color/btn"
        android:text="LT"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/btnLB"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnRB"
        android:layout_width="72dp"
        android:layout_height="40dp"
        android:layout_margin="10dp"
        android:background="@color/btn"
        android:text="RB"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnRT"
        android:layout_width="72dp"
        android:layout_height="40dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="6dp"
        android:background="@color/btn"
        android:text="RT"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/btnRB"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- D-pad cluster -->
    <RelativeLayout
        android:id="@+id/dpadCluster"
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/leftStick">

        <Button
            android:id="@+id/btnUp"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:background="@color/btn"
            android:text="▲"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnDown"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:background="@color/btn"
            android:text="▼"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnLeft"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@color/btn"
            android:text="◀"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnRight"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@color/btn"
            android:text="▶"
            android:textColor="#FFFFFF" />
    </RelativeLayout>

    <com.phonepad.gamepad.JoystickView
        android:id="@+id/leftStick"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Face buttons cluster (Xbox layout: Y top, X left, B right, A bottom) -->
    <RelativeLayout
        android:id="@+id/faceCluster"
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/rightStick">

        <Button
            android:id="@+id/btnY"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:background="@color/btn"
            android:text="Y"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnA"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:background="@color/btn"
            android:text="A"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnX"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@color/btn"
            android:text="X"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnB"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@color/btn"
            android:text="B"
            android:textColor="#FFFFFF" />
    </RelativeLayout>

    <com.phonepad.gamepad.JoystickView
        android:id="@+id/rightStick"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
